{
  "name": "tabtrainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source player and editor of tab with rhythm for electric bass and guitar.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "song": "vite-node scripts/song.ts",
    "render-song": "vite-node e2e/render-song.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "prettier --check \"src/**/*.css\"",
    "format:css": "prettier --write \"src/**/*.css\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "vexflow": "4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
